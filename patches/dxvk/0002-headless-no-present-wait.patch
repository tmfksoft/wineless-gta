+    // Wineless: Mesa's VK_EXT_headless_surface swapchain (SDL's "offscreen"
+    // driver, used on display-less emulation nodes) never implements
+    // wait_for_present in any release up to at least 25.3, and release builds
+    // compile out the assert in wsi_WaitForPresentKHR, so the presenter's frame
+    // thread calls a NULL pointer on the first FIFO present. Present wait only
+    // drives frame pacing; without it the presenter falls back to its limiter.
+    // WINELESS_PRESENT_WAIT=1 forces it back on, =0 forces it off.
+    { std::string pw = env::getEnvVar("WINELESS_PRESENT_WAIT");
+      bool disablePresentWait = pw.empty()
+        ? env::getEnvVar("SDL_VIDEO_DRIVER") == "offscreen"
+        : pw == "0";
+
+      if (disablePresentWait && m_featuresSupported.khrPresentWait.presentWait) {
+        Logger::info("DXVK: present wait disabled (headless surface)");
+        m_featuresSupported.khrPresentWait.presentWait = VK_FALSE;
+      }
+    }
+
     // For line rasterization, ensure that the feature set actually makes sense

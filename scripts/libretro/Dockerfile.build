FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git pkg-config ca-certificates \
      python3 python3-venv python3-pip \
      rsync \
      libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev \
      libxfixes-dev libxss-dev libxkbcommon-dev \
      libwayland-dev wayland-protocols \
      libpulse-dev libasound2-dev libdbus-1-dev libudev-dev \
      libdrm-dev libgbm-dev libgl1-mesa-dev libegl1-mesa-dev libglu1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*
